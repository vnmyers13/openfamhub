# OpenFamHub server settings. Created by `scripts/deploy.sh remote` on first
# deploy; edit on the server and re-run the deploy to apply.

# ---- Images ----
# Where `deploy.sh publish` pushed the images, and which version to run.
REGISTRY=__REGISTRY__
OPENFAMHUB_VERSION=__VERSION__

# ---- Networking ----
# Behind another reverse proxy (default): Caddy serves plain HTTP on HTTP_PORT.
# Point your proxy at http://<this-server>:HTTP_PORT.
CADDYFILE=Caddyfile.proxy
HTTP_PORT=8080
HTTPS_PORT=8443
# LAN mode instead: CADDYFILE=Caddyfile, SITE_ADDRESS=<hostname>, ports 80/443.
SITE_ADDRESS=openfamhub.local

# The public URL people use (must match exactly, scheme included).
ALLOWED_ORIGINS=__PUBLIC_URL__

# ---- App ----
# Family name/timezone for the calendar are set in the setup wizard.
FAMILY_NAME=My Family
# Timezone for BACKUP_TIME.
TIMEZONE=America/Detroit
# Generated on first deploy. BACK IT UP: changing or losing it signs
# everyone out (wall displays stay paired).
SECRET_KEY=__SECRET_KEY__
DATABASE_URL=sqlite+aiosqlite:////data/db/homehub.db
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=03:00
WALL_IDLE_TIMEOUT_SECONDS=300
