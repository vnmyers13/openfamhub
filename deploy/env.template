# OpenFamHub server settings. Created by `scripts/deploy.sh remote` on first
# deploy; edit on the server and re-run the deploy to apply.

# ---- Images ----
# Where `deploy.sh publish` pushed the images, and which version to run.
REGISTRY=__REGISTRY__
OPENFAMHUB_VERSION=__VERSION__

# ---- Networking ----
# Behind another reverse proxy (default): Caddy serves plain HTTP on HTTP_PORT.
# Point your proxy at http://<this-server>:HTTP_PORT.
CADDYFILE=Caddyfile.proxy
HTTP_PORT=8080
HTTPS_PORT=8443
# LAN mode instead: CADDYFILE=Caddyfile, SITE_ADDRESS=<hostname>, ports 80/443.
SITE_ADDRESS=openfamhub.local

# The public URL people use (must match exactly, scheme included).
ALLOWED_ORIGINS=__PUBLIC_URL__

# ---- App ----
# The family name and timezone are set in the app (setup wizard, Admin › Settings).
# Timezone for BACKUP_TIME.
TIMEZONE=America/Detroit
# Generated on first deploy. BACK IT UP: changing or losing it signs
# everyone out (wall displays stay paired).
SECRET_KEY=__SECRET_KEY__
DATABASE_URL=sqlite+aiosqlite:////data/db/homehub.db
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=03:00
WALL_IDLE_TIMEOUT_SECONDS=300

# ---- Optional: set these here or in the app (Admin › Settings). ----
# A value here wins over the app and locks that field there.
# ---- Notifications besides Web Push (optional; each is off while empty) ----
# ntfy: people add their own topic in My settings › Notifications.
# Use https://ntfy.sh or your own ntfy server; NTFY_TOKEN if it needs one.
NTFY_URL=
NTFY_TOKEN=
# Email: people add their own address in My settings › Notifications.
# SMTP_SECURITY is starttls (usually port 587), ssl (465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Home Assistant (optional; off while empty) ----
# HA_URL is how the API container reaches Home Assistant, e.g. http://192.168.1.20:8123
# HA_TOKEN: Home Assistant › your profile › Security › Long-lived access tokens.
HA_URL=
HA_TOKEN=
