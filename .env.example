# OpenFamHub environment configuration (local / build-from-source stack).
# Copy to .env (or run `scripts/deploy.sh setup`, which also generates SECRET_KEY).
# Servers deployed with `scripts/deploy.sh remote` use deploy/env.template instead.

# ---- App ----

# IANA timezone for BACKUP_TIME (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/New_York

# 64-char hex secret used to sign login tokens. Generate: openssl rand -hex 32
# BACK THIS UP. Changing or losing it signs everyone out.
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

# SQLite database (path inside the api container; ./data/db on the host)
DATABASE_URL=sqlite+aiosqlite:////data/db/homehub.db

# Allowed CORS origins (comma-separated, scheme included)
ALLOWED_ORIGINS=https://openfamhub.local

# Backup retention (days) and daily backup time (24h HH:MM, in TIMEZONE)
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=03:00

# Wall display idle timeout (seconds before showing the clock screen)
WALL_IDLE_TIMEOUT_SECONDS=300

# ---- Optional: set these here or in the app (Admin › Settings). ----
# A value here wins over the app and locks that field there.
# ---- Notifications besides Web Push (optional; each is off while empty) ----
# ntfy: people add their own topic in My settings › Notifications.
# Use https://ntfy.sh or your own ntfy server; NTFY_TOKEN if it needs one.
NTFY_URL=
NTFY_TOKEN=
# Email: people add their own address in My settings › Notifications.
# SMTP_SECURITY is starttls (usually port 587), ssl (465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Home Assistant (optional; off while empty) ----
# HA_URL is how the API container reaches Home Assistant, e.g. http://192.168.1.20:8123
# HA_TOKEN: Home Assistant › your profile › Security › Long-lived access tokens.
HA_URL=
HA_TOKEN=

# ---- Networking (docker-compose.yml) ----
# Caddyfile        = LAN mode, Caddy serves HTTPS with its internal CA (default)
# Caddyfile.proxy  = plain HTTP behind another reverse proxy
CADDYFILE=Caddyfile
SITE_ADDRESS=openfamhub.local
HTTP_PORT=80
HTTPS_PORT=443

# ---- Images (scripts/deploy.sh publish) ----
# Registry/owner the images are pushed to, e.g. your Forgejo container registry.
REGISTRY=forgejo.vernonmyers.cloud/vernon
# Defaults to <release> from the VERSION file (repo root) when unset; deploy.sh sets it.
# OPENFAMHUB_VERSION=0.71
