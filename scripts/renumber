#!/bin/bash
# Renumber commits after a rebase so VERSION is base+1, base+2, ... (see the design spec).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--step" ]; then
    # A parent without VERSION means this commit predates adoption: it must carry no number.
    if ! parent=$(git show HEAD^:VERSION 2>/dev/null | tr -d '[:space:]'); then
        exit 0
    fi
    [ -n "$parent" ] || exit 0
    case "$parent" in ''|*[!0-9]*) echo "renumber: parent VERSION is not numeric ('$parent')" >&2; exit 1;; esac
    n=$((parent + 1))
    printf '%s\n' "$n" > VERSION
    if [ -f README.md ]; then
        sed -i.bak -E "s|version-[0-9][0-9.]*-blue|version-$(scripts/release-name "$n")-blue|g" README.md
        rm -f README.md.bak
        git add README.md
    fi
    git add VERSION
    # --no-verify: core.hooksPath runs .githooks/pre-commit on the amend, which
    # would bump VERSION a second time and land the commit at parent+2.
    git commit --amend --no-edit --no-verify >/dev/null
    exit 0
fi

base="${1:-$(git merge-base HEAD master)}"
exec git rebase --exec "$0 --step" "$base"
